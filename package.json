{
  "name": "pr-reviewer",
  "version": "1.0.0",
  "scripts": {
    "test": "npm test --workspaces",
    "tunnel": "dotenv -- sh -c 'npx smee-client@5 -u $SMEE_URL -t http://localhost:3333/webhooks/github'",
    "agent": "cd apps/agent && uv run python -m pr_agent",
    "agent:eval": "AGENT_TARBALL_CACHE=\"$PWD/evals/.cache\" npm run agent",
    "agent:model": "ollama create pr-reviewer:qwen2.5-7b -f apps/agent/ollama/Modelfile",
    "web": "npm run dev -w web"
  },
  "license": "MIT",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "devDependencies": {
    "dotenv-cli": "^11.0.0"
  }
}
