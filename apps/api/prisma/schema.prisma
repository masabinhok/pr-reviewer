generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ReviewStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum DeliveryStatus {
  RECEIVED
  PROCESSED 
  IGNORED 
  FAILED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
}
enum FindingSide {
  LEFT
  RIGHT
}
enum FindingStatus {
  OPEN
  RESOLVED
}
/// Who decided a finding is done with.
enum ResolvedBy {
  /// A later review: the code the comment pointed at is gone, and the review didn't find it again.
  APP
  /// Someone resolved the thread on GitHub.
  PERSON
}

/// How the agent's second look went; a refuted finding is never stored.
enum Verdict {
  CONFIRMED
  UNSURE
  UNVERIFIED
}

enum FeedbackSignal {
  UP
  DOWN
}



model Installation {
  id           String    @id @default(cuid())
  githubId     BigInt    @unique
  accountLogin String
  accountType  String
  suspendedAt  DateTime?
  deletedAt    DateTime?

  repos             Repo[]
  webhookDeliveries WebhookDelivery[]
}

model Repo {
  id             String       @id @default(cuid())
  githubId       BigInt       @unique
  fullName       String       @unique
  installation   Installation @relation(fields: [installationId], references: [id])
  installationId String
  defaultBranch  String?
  private        Boolean
  deletedAt      DateTime?

  reviews Review[]

  @@index([installationId])
}


model Review {
  id                String       @id @default(cuid())
  repo              Repo         @relation(fields: [repoId], references: [id])
  repoId            String
  prNumber          Int
  baseSha           String
  headSha           String
  status            ReviewStatus
  startedAt         DateTime     @default(now())
  completedAt       DateTime?
  error             String?
  skipReason        String?
  // The reviewer's raw answer, stored the moment it arrives: a retry reuses it instead of
  // paying the agent again. Validated findings are the Finding rows; this is the evidence.
  agentResult       Json?
  promptTokens      Int?
  completionTokens  Int?
  costCents         Int?
  checkRunId        BigInt?
  // The GitHub review posted for this Review. Set right after posting; a retry that finds
  // it posts nothing.
  githubReviewId    BigInt?

  findings Finding[]

  @@unique([repoId, prNumber, headSha])
  @@index([status])
}

model Finding {
  id              String        @id @default(cuid())
  review          Review        @relation(fields: [reviewId], references: [id])
  reviewId        String
  filePath        String
  line            Int
  side            FindingSide
  status          FindingStatus @default(OPEN)
  severity        Severity
  category        String
  summary         String
  whyItBreaks     String
  suggestedFix    String?
  fingerprint     String
  githubCommentId BigInt?
  /// Null when there was no second look (the stub, or AGENT_VERIFY off).
  verdict         Verdict?
  verdictReason   String?
  /// Set when an unconfirmed finding was demoted to LOW.
  demotedFrom     Severity?
  /// Where the finding points: one hash per line of real code within two lines of it (file +
  /// side + normalised code; no line number, no category). Two findings whose anchors share a
  /// hash are the same comment for dedupe across pushes — see `anchors()`.
  anchors         String[]
  /// This finding repeats one already commented on in an earlier review of the same PR, and
  /// was not posted again.
  repeatOf        Finding?  @relation("Repeats", fields: [repeatOfId], references: [id])
  repeatOfId      String?
  repeats         Finding[] @relation("Repeats")
  resolvedAt      DateTime?
  resolvedBy      ResolvedBy?
  /// The ETag of the comment's reactions as last read; sent back as If-None-Match, so an
  /// unchanged comment costs a 304 and no rate limit.
  reactionsEtag   String?
  /// Set when GitHub says the comment no longer exists (someone deleted it). Not polled again.
  commentGoneAt   DateTime?

  feedbacks Feedback[]

  @@index([fingerprint])
  @@index([anchors], type: Gin)
}

model Feedback {
  id           String         @id @default(cuid())
  finding      Finding        @relation(fields: [findingId], references: [id])
  findingId    String
  signal       FeedbackSignal
  githubUserId BigInt
  /// When they reacted, as GitHub records it.
  reactedAt    DateTime?

  @@unique([findingId, githubUserId])
}

model WebhookDelivery {
  id             String        @id @default(cuid())
  deliveryId     String        @unique
  event          String
  status         DeliveryStatus @default(RECEIVED)
  action         String?
  installation   Installation? @relation(fields: [installationId], references: [id])
  installationId String?
  receivedAt     DateTime      @default(now())
  processedAt    DateTime?
  error String?
}
