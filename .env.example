POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
PORT=
DATABASE_URL=
REDIS_URL=
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY_BASE64=
SMEE_URL=
AGENT_URL=
# Where the agent listens. Default 127.0.0.1; 0.0.0.0 inside a container.
AGENT_HOST=
AGENT_SHARED_SECRET=
# The agent's model. Default: a local model through Ollama, free (`npm run agent:model`).
# For Claude, bring your own key: AGENT_PROVIDER=anthropic and ANTHROPIC_API_KEY.
AGENT_PROVIDER=ollama
ANTHROPIC_API_KEY=
# The least severe finding posted as a comment: high (default), medium or low.
POST_MIN_SEVERITY=high
# How often reactions on the App's comments are polled, in ms (GitHub has no reaction webhook). 0 turns it off.
FEEDBACK_POLL_MS=300000
# The dashboard API's bearer token (openssl rand -hex 32). Unset: the dashboard is off.
DASHBOARD_TOKEN=
