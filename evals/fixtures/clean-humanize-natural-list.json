                "newLine": 2,
                "content": ""
              },
              {
                "kind": "add",
                "newLine": 3,
                "content": "from __future__ import annotations"
              },
              {
                "kind": "add",
                "newLine": 4,
                "content": ""
              },
              {
                "kind": "add",
                "newLine": 5,
                "content": "from typing import Any"
              },
              {
                "kind": "add",
                "newLine": 6,
                "content": ""
              },
              {
                "kind": "add",
                "newLine": 7,
                "content": "__all__ = [\"natural_list\"]"
              },
              {
                "kind": "add",
                "newLine": 8,
                "content": ""
              },
              {
                "kind": "add",
                "newLine": 9,
                "content": ""
              },
              {
                "kind": "add",
                "newLine": 10,
                "content": "def natural_list(items: list[Any]) -> str:"
              },
              {
                "kind": "add",
                "newLine": 11,
                "content": "    \"\"\"Natural list."
              },
              {
                "kind": "add",
                "newLine": 12,
                "content": ""
              },
              {
                "kind": "add",
                "newLine": 13,
                "content": "    Convert a list of items into a human-readable string with commas and 'and'."
              },
              {
                "kind": "add",
                "newLine": 14,
                "content": ""
              },
              {
                "kind": "add",
                "newLine": 15,
                "content": "    Examples:"
              },
              {
                "kind": "add",
                "newLine": 16,
                "content": "        >>> natural_list([\"one\", \"two\", \"three\"])"
              },
              {
                "kind": "add",
                "newLine": 17,
                "content": "        'one, two and three'"
              },
              {
                "kind": "add",
                "newLine": 18,
                "content": "        >>> natural_list([\"one\", \"two\"])"
              },
              {
                "kind": "add",
                "newLine": 19,
                "content": "        'one and two'"
              },
              {
                "kind": "add",
                "newLine": 20,
                "content": "        >>> natural_list([\"one\"])"
              },
              {
                "kind": "add",
                "newLine": 21,
                "content": "        'one'"
              },
              {
                "kind": "add",
                "newLine": 22,
                "content": ""
              },
              {
                "kind": "add",
                "newLine": 23,
                "content": "    Args:"
              },
              {
                "kind": "add",
                "newLine": 24,
                "content": "        items (list): An iterable of items."
              },
              {
                "kind": "add",
                "newLine": 25,
                "content": ""
              },
              {
                "kind": "add",
                "newLine": 26,
                "content": "    Returns:"
              },
              {
                "kind": "add",
                "newLine": 27,
                "content": "        str: A string with commas and 'and' in the right places."
              },
              {
                "kind": "add",
                "newLine": 28,
                "content": "    \"\"\""
              },
              {
                "kind": "add",
                "newLine": 29,
                "content": "    if len(items) == 1:"
              },
              {
                "kind": "add",
                "newLine": 30,
                "content": "        return str(items[0])"
              },
              {
                "kind": "add",
                "newLine": 31,
                "content": "    elif len(items) == 2:"
              },
              {
                "kind": "add",
                "newLine": 32,
                "content": "        return f\"{str(items[0])} and {str(items[1])}\""
              },
              {
                "kind": "add",
                "newLine": 33,
                "content": "    else:"
              },
              {
                "kind": "add",
                "newLine": 34,
                "content": "        return \", \".join(str(item) for item in items[:-1]) + f\" and {str(items[-1])}\""
              }
            ]
          }
        ]
      }
